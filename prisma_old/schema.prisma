// ──────────────────────────────────────────────────────────────
// ShopAccounting v4.3 — Combined Schema (برای دیتابیس موجود)
// ──────────────────────────────────────────────────────────────
// این schema برای دیتابیس ShopAccounting فعلی استفاده می‌شه
// که هم جداول master و هم جداول tenant رو داره
//
// ⚠️ مهم: این schema جایگزین schema.prisma فعلی شماست
//    فقط ۳ فیلد جدید به مدل Tenant اضافه شده + اصلاحات روابط
// ──────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/master"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// مدل‌های Master (مدیریتی) — همیشه در دیتابیس اصلی
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id                        String   @id @default(uuid())
  subDomain                 String   @unique
  companyName               String
  planName                  String   @default("basic")
  status                    String   @default("active")

  // ─── فیلدهای معماری Hybrid (جدید) ───
  dbName                    String?
  connectionStringEncrypted String?
  isIsolated                Boolean  @default(false)

  ownerName                 String?
  ownerMobile               String?
  ownerEmail                String?
  address                   String?
  registrationNumber        String?
  logoUrl                   String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  subscriptions             Subscription[]
  subscriptionPayments      SubscriptionPayment[]
  portalUsers               PortalUser[]
  otpCodes                  OtpCode[]
  auditLogs                 AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("Tenants")
}

model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  nameFa          String
  price           Float
  durationDays    Int
  maxUsers        Int      @default(2)
  maxProducts     Int      @default(100)
  features        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions   Subscription[]

  @@index([isActive])
  @@map("Plans")
}

model Subscription {
  id              String   @id @default(uuid())
  tenantId        String
  planId          String
  startDate       DateTime
  endDate         DateTime
  status          String   @default("active")
  autoRenew       Boolean  @default(false)
  createdAt       DateTime @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  plan            Plan                @relation(fields: [planId], references: [id])
  payments        SubscriptionPayment[]

  @@index([tenantId, status])
  @@index([status])
  @@index([endDate])
  @@map("Subscriptions")
}

model SubscriptionPayment {
  id              String   @id @default(uuid())
  subscriptionId  String
  tenantId        String
  amount          Float
  paymentMethod   String?
  paymentRef      String?
  isPaid          Boolean  @default(false)
  status          String   @default("pending")
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, isPaid])
  @@index([paidAt])
  @@map("SubscriptionPayments")
}

model PortalUser {
  id              String   @id @default(uuid())
  tenantId        String
  username        String
  password        String
  mobile          String?
  role            String   @default("Manager")
  permissions     String?
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([mobile])
  @@map("PortalUsers")
}

model OtpCode {
  id              String   @id @default(uuid())
  tenantId        String
  mobile          String
  code            String
  purpose         String   @default("login")
  isUsed          Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([mobile, purpose, isUsed, expiresAt])
  @@index([expiresAt])
  @@map("OtpCodes")
}

model AuditLog {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String?
  action          String
  entityType      String?
  entityId        String?
  details         String?
  at              DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, action])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([at])
  @@map("AuditLogs")
}

// ═══════════════════════════════════════════════════════════════
// مدل‌های Tenant (فروشگاه) — فعلاً در دیتابیس مشترک
// بعد از migration به دیتابیس‌های مستقل منتقل می‌شن
// ═══════════════════════════════════════════════════════════════

model StoreUser {
  id              String   @id @default(uuid())
  username        String
  password        String
  mobile          String?
  role            String   @default("Cashier")
  permissions     String?
  tenantId        String   @default("default")
  storeId         String?
  storeName       String?
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices        Invoice[]

  @@unique([tenantId, username])
  @@index([tenantId, isActive])
  @@index([tenantId, role])
  @@index([mobile, tenantId])
  @@map("StoreUsers")
}

model ProductCategory {
  id              String   @id @default(uuid())
  name            String
  parentId        String?
  isActive        Boolean  @default(true)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())

  products        Product[]
  parent          ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        ProductCategory[] @relation("CategoryHierarchy")

  @@index([tenantId, isActive])
  @@index([parentId])
  @@map("ProductCategories")
}

model Unit {
  id              String   @id @default(uuid())
  name            String
  symbol          String?
  isActive        Boolean  @default(true)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())

  products        Product[]

  @@index([tenantId])
  @@map("Units")
}

model Product {
  id              String   @id @default(uuid())
  code            String   @unique
  barcode         String?
  name            String
  categoryId      String?
  unitId          String?
  purchasePrice   Float    @default(0)
  salePrice       Float    @default(0)
  taxRate         Float    @default(0)
  currentStock    Float    @default(0)
  minStock        Float    @default(0)
  isActive        Boolean  @default(true)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit            Unit?            @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoiceItems    InvoiceItem[]
  stockMovements  StockMovement[]

  @@index([tenantId, isActive])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive, name])
  @@index([name, tenantId])
  @@index([barcode, tenantId])
  @@index([tenantId, currentStock])
  @@map("Products")
}

model Customer {
  id              String   @id @default(uuid())
  code            String   @unique
  firstName       String
  lastName        String   @default("")
  mobile          String?
  nationalCode    String?
  address         String?
  creditLimit     Float    @default(0)
  currentBalance  Float    @default(0)
  isBlacklisted   Boolean  @default(false)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  lastPurchaseAt  DateTime?

  invoices        Invoice[]
  installmentPlans InstallmentPlan[]

  @@index([tenantId])
  @@index([tenantId, mobile])
  @@index([tenantId, isBlacklisted])
  @@index([tenantId, firstName, lastName])
  @@map("Customers")
}

model Invoice {
  id              String   @id @default(uuid())
  number          String   @unique
  customerId      String?
  invoiceDate     DateTime @default(now())
  dueDate         DateTime?
  status          String   @default("draft")
  paymentType     String   @default("cash")
  subTotal        Float    @default(0)
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  remainingAmount Float    @default(0)
  cashierId       String?
  description     String?
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cashier         StoreUser?      @relation(fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           InvoiceItem[]
  payments        InvoicePayment[]
  installmentPlan InstallmentPlan?

  @@index([tenantId, status])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, customerId])
  @@index([tenantId, cashierId])
  @@index([tenantId, paymentType])
  @@index([tenantId, status, invoiceDate])
  @@index([dueDate, status, tenantId])
  @@map("Invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  productId       String?
  productName     String
  quantity        Float    @default(1)
  unitPrice       Float    @default(0)
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  lineTotal       Float    @default(0)

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoiceId])
  @@index([productId])
  @@map("InvoiceItems")
}

model InvoicePayment {
  id              String   @id @default(uuid())
  invoiceId       String
  amount          Float
  paymentType     String   @default("cash")
  paymentRef      String?
  paidAt          DateTime @default(now())

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paidAt])
  @@map("InvoicePayments")
}

model InstallmentPlan {
  id              String   @id @default(uuid())
  invoiceId       String   @unique
  customerId      String?
  totalAmount     Float
  totalInstallments Int
  paidInstallments Int    @default(0)
  paidAmount      Float    @default(0)
  remainingAmount Float
  monthlyAmount   Float
  startDate       DateTime
  endDate         DateTime?
  status          String   @default("active")
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())

  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  installments    Installment[]

  @@index([tenantId])
  @@index([invoiceId])
  @@map("InstallmentPlans")
}

model Installment {
  id              String   @id @default(uuid())
  planId          String
  installmentNumber Int
  amount          Float
  dueDate         DateTime
  paidAt          DateTime?
  status          String   @default("pending")
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())

  plan            InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([planId, status])
  @@index([dueDate, status])
  @@map("Installments")
}

model StockMovement {
  id              String   @id @default(uuid())
  productId       String?
  movementType    String
  quantity        Float
  previousStock   Float    @default(0)
  newStock        Float    @default(0)
  reason          String?
  reference       String?
  userId          String?
  at              DateTime @default(now())
  tenantId        String   @default("default")

  product         Product? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, at])
  @@index([productId, at])
  @@index([movementType])
  @@index([reference])
  @@map("StockMovements")
}

model Account {
  id              String   @id @default(uuid())
  code            String
  name            String
  type            String
  level           Int      @default(1)
  parentId        String?
  isActive        Boolean  @default(true)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())

  journalEntryLines JournalEntryLine[]
  parent          Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        Account[] @relation("AccountHierarchy")

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, level])
  @@index([parentId])
  @@map("Accounts")
}

model FiscalYear {
  id              String   @id @default(uuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  status          String   @default("active")
  isClosed        Boolean  @default(false)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())

  journalEntries  JournalEntry[]

  @@index([tenantId, status])
  @@map("FiscalYears")
}

model JournalEntry {
  id              String   @id @default(uuid())
  number          String
  fiscalYearId    String?
  entryDate       DateTime
  entryType       String   @default("manual")
  referenceType   String?
  referenceId     String?
  description     String?
  totalDebit      Float    @default(0)
  totalCredit     Float    @default(0)
  status          String   @default("draft")
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())

  fiscalYear      FiscalYear?     @relation(fields: [fiscalYearId], references: [id])
  lines           JournalEntryLine[]

  @@index([tenantId, status])
  @@index([tenantId, entryDate])
  @@index([tenantId, entryType])
  @@index([referenceType, referenceId])
  @@map("JournalEntries")
}

model JournalEntryLine {
  id              String   @id @default(uuid())
  journalEntryId  String
  accountId       String?
  debit           Float    @default(0)
  credit          Float    @default(0)
  description     String?

  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         Account?     @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([accountId, journalEntryId])
  @@map("JournalEntryLines")
}

model PaymentGatewaySetting {
  id              String   @id @default(uuid())
  gatewayType     String   @default("zarinpal")
  merchantId      String?
  apiKey          String?
  isSandbox       Boolean  @default(true)
  isActive        Boolean  @default(false)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, isActive])
  @@map("PaymentGatewaySettings")
}

model PosSetting {
  id              String   @id @default(uuid())
  connectionType  String   @default("simulator")
  terminalId      String?
  merchantCode    String?
  isActive        Boolean  @default(false)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@map("PosSettings")
}

model StoreSetting {
  id              String   @id @default(uuid())
  storeName       String?
  address         String?
  phone           String?
  registrationNumber String?
  defaultTaxRate  Float    @default(9)
  logoUrl         String?
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@map("StoreSettings")
}

model InvoiceTemplate {
  id              String   @id @default(uuid())
  headerText      String   @default("فاکتور فروش")
  footerText      String   @default("با تشکر از خرید شما")
  bankAccounts    String?
  contactInfo     String?
  primaryColor    String   @default("#059669")
  showTax         Boolean  @default(true)
  showDiscount    Boolean  @default(true)
  logoUrl         String?
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@map("InvoiceTemplates")
}

model Notification {
  id              String   @id @default(uuid())
  userId          String?
  title           String
  message         String
  type            String   @default("info")
  isRead          Boolean  @default(false)
  tenantId        String   @default("default")
  createdAt       DateTime @default(now())

  @@index([userId, isRead])
  @@index([type, tenantId])
  @@index([tenantId, createdAt])
  @@map("Notifications")
}
