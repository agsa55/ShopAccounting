  referenceType   String? @db.VarChar(20) // ★★★ v8.1: نوع کد مرجع (rrn | unique_code | trace | terminal | auth_code | stan | other)
  traceNumber     String? @db.VarChar(50) // شماره پیگیری
  cardNumber      String? @db.VarChar(4) // ۴ رقم آخر کارت
  cardType        String? @db.VarChar(20) // bankaii | melli | saderat | ... | unknown

  // وضعیت
  status String @default("pending") @db.VarChar(20) // pending | successful | failed | reversed

  // ارتباط با کارتخوان
  posDeviceId String? @db.VarChar(450)

  // تأیید شاپرک
  shaparakVerified    Boolean @default(false)
  shaparakVerifyError String? @db.VarChar(500)

  // متادیتا
  paidAt      DateTime @default(now())
  description String?
  tenantId    String   @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ★★★ v8.0: relations
  posDevice PosDevice? @relation(fields: [posDeviceId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  invoice   Invoice?   @relation("CardPaymentInvoice", fields: [invoiceId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  Tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, paidAt])
  @@index([posDeviceId])
  @@index([invoiceId])
  @@index([referenceNumber])
  @@map("CardPayments")
}

