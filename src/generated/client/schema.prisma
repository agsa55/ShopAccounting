  Supplier     Supplier?             @relation(fields: [supplierId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Warehouse    Warehouse             @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  journalEntry JournalEntry?         @relation("PurchaseInvoiceJournalEntry", fields: [journalEntryId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  items        PurchaseInvoiceItem[]

  @@unique([number, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, invoiceType])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([originalPurchaseInvoiceId])
  @@map("PurchaseInvoices")
}

model PurchaseInvoiceItem {
  id                String  @id @default(uuid()) @db.VarChar(450)
  purchaseInvoiceId String  @db.VarChar(450)
  productId         String? @db.VarChar(450)
  productName       String  @db.VarChar(500)
  productCode       String? @db.VarChar(50) // ★ اضافه: کد محصول

  // ★★★ v8.8.7: واحد محصول (عدد، کیلوگرم، متر، ...)
  unitLabel String @default("عدد") @db.VarChar(50)

  // ★★★ v10.0: تغییر به Decimal
  quantity       Decimal @default(1) @db.Decimal(18, 4) // ★ v10.0: از Float به Decimal (برای اعشاری)
  unitPrice      Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal @default(0) @db.Decimal(18, 2)

  // ★★★ v8.7: دلیل برگشت (فقط برای فاکتورهای برگشتی خرید، اختیاری)
  returnReason String? @db.VarChar(500)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  Product         Product?        @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([purchaseInvoiceId])
  @@index([productId])
  @@map("PurchaseInvoiceItems")
}

// ═══════════════════════════════════════════════════════════════
//  ★★★ v6.5: مدل‌های انبار گردانی (Stock Count / Inventory Audit)
// ═══════════════════════════════════════════════════════════════

model StockCount {
  id              String    @id @default(uuid()) @db.VarChar(450)
  tenantId        String    @db.VarChar(1000)
  number          String // SC-0001
  warehouseId     String    @db.VarChar(450)
  countDate       DateTime  @default(now())
  status          String    @default("draft") // draft / in_progress / completed / cancelled
  countedBy       String?   @db.VarChar(450)
  approvedBy      String?   @db.VarChar(450)
  approvedAt      DateTime?
  notes           String?   @db.VarChar(500)
  journalEntryId  String?   @db.VarChar(450) // سند حسابداری خودکار (FK ساده، بدون relation)
  // ★★★ v10.0: تغییر به Decimal
  totalDifference Decimal   @default(0) @db.Decimal(18, 2) // جمع مالی اختلاف
  totalItems      Int       @default(0) // تعداد آیتم‌های شمارش
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  Tenant    Tenant           @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  Warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  items     StockCountItem[]

  @@unique([number, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, countDate])
  @@index([warehouseId])
  @@index([countedBy])
  @@index([journalEntryId])
  @@map("StockCounts")
}

model StockCountItem {
  id           String @id @default(uuid()) @db.VarChar(450)
  stockCountId String @db.VarChar(450)
  productId    String @db.VarChar(450)

  // ★★★ v8.8.7: واحد محصول
  unitLabel String @default("عدد") @db.VarChar(50)

  // ★★★ v10.0: تغییر به Decimal
  systemQty        Decimal  @default(0) @db.Decimal(18, 4) // ★ v10.0: از Float به Decimal(18,4)
  countedQty       Decimal  @default(0) @db.Decimal(18, 4)
  difference       Decimal  @default(0) @db.Decimal(18, 4)
  unitCost         Decimal  @default(0) @db.Decimal(18, 2)
  differenceAmount Decimal  @default(0) @db.Decimal(18, 2)
  reason           String?  @db.VarChar(500)
  countedAt        DateTime @default(now())

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  Product    Product    @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([stockCountId])
  @@index([productId])
  @@index([stockCountId, productId])
  @@map("StockCountItems")
}

model Branch {
  id        String   @id @default(uuid()) @db.VarChar(450)
  tenantId  String   @db.VarChar(1000)
  name      String
  code      String
  address   String?
  phone     String?
  manager   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  // ★★★ این خط را به مدل Branch اضافه کنید:
  JournalEntries JournalEntry[]
  warehouses     Warehouse[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@map("Branches")
}

// ═══════════════════════════════════════════════════════════════
// ★★★ v8.6: سیستم تیکت پشتیبانی
// هر تیکت مال یک Tenant (فروشگاه) خاص است و کاملاً ایزوله است.
// هر سه پلن (ساده/حرفه‌ای/سازمانی) به یک اندازه دسترسی دارند.
// ═══════════════════════════════════════════════════════════════

model Ticket {
  id               String    @id @default(uuid()) @db.VarChar(450)
  tenantId         String    @db.VarChar(1000)
  ticketNumber     String    @unique // مثلاً TKT-14030624-0001
  subject          String    @db.VarChar(500)
  description      String    @db.Text // متن اولیه تیکت
  category         String    @default("general") // general | bug | feature | billing | account | accounting | pos
  priority         String    @default("normal") // low | normal | high | urgent
  status           String    @default("open") // open | pending | answered | resolved | closed
  // ★ کاربری که تیکت را باز کرده (از فروشگاه)
  createdById      String    @db.VarChar(450)
  // ★ ادمینی که تیکت به او اختصاص داده شده (null = تخصیص داده نشده)
  assignedTo       String?   @db.VarChar(450)
  // ★ رتبه پلن فعلی فروشگاه در زمان ثبت تیکت (برای گزارش‌گیری)
  planTierAtCreate String?   @db.VarChar(50)
  // ★ فایل‌های پیوست (JSON آرایه‌ای از آدرس‌ها)
  attachments      String?   @db.Text
  // ★ امتیاز رضایت کاربر (۱ تا ۵) — فقط بعد از بسته شدن
  rating           Int?
  ratingComment    String?   @db.VarChar(500)
  ratedAt          DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  firstResponseAt DateTime? // زمان اولین پاسخ ادمین
  resolvedAt      DateTime?
  closedAt        DateTime?

  Tenant    Tenant          @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  CreatedBy StoreUser       @relation(fields: [createdById], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Messages  TicketMessage[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status])
  @@index([assignedTo])
  @@index([priority])
  @@index([category])
  @@map("Tickets")
}

model TicketMessage {
  id          String   @id @default(uuid()) @db.VarChar(450)
  ticketId    String   @db.VarChar(450)
  // ★ senderType: "customer" (از فروشگاه) | "admin" (از پشتیبان)
  senderType  String   @default("customer")
  senderId    String   @db.VarChar(450)
  senderName  String   @db.VarChar(200) // کش شده برای نمایش سریع
  message     String   @db.Text
  attachments String?  @db.Text // JSON آرایه آدرس فایل‌ها
  isInternal  Boolean  @default(false) // یادداشت داخلی پشتیبان (کاربر نمی‌بیند)
  isRead      Boolean  @default(false) // آیا گیرنده آن را خوانده
  createdAt   DateTime @default(now())

  Ticket Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  Sender StoreUser @relation(fields: [senderId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@index([senderId])
  @@index([senderType])
  @@map("TicketMessages")
}

// ═══════════════════════════════════════════════════════════════
// ★★★ v8.8: راه‌اندازی اولیه فروشگاه (Initial Balance Setup)
// ----------------------------------------------------------------------------
// این مدل موجودی‌های اولیه فروشگاه رو ذخیره می‌کنه:
//   - موجودی نقد (صندوق و بانک)
//   - موجودی کالا
//   - دارایی‌های ثابت (تجهیزات)
//   - بدهی‌های اولیه
//   - سرمایه مالک
// و سند افتتاحیه خودکار صادر می‌کنه.
// ═══════════════════════════════════════════════════════════════

model InitialBalance {
  id       String @id @default(uuid()) @db.VarChar(450)
  tenantId String @db.VarChar(1000)

  // ★ نوع موجودی اولیه
  // cash: موجودی نقد (صندوق)
  // bank: موجودی بانکی
  // inventory: موجودی کالا
  // fixed_asset: دارایی ثابت (تجهیزات)
  // liability: بدهی اولیه (وام)
  // equity: سرمایه مالک
  type String @db.VarChar(30)

  // ★ عنوان (مثلاً: "صندوق فروشگاه"، "یخچال"، "وام بانک ملی")
  title String @db.VarChar(200)

  // ★ مبلغ (ریال)
  // ★★★ v10.0: تغییر به Decimal
  amount Decimal @default(0) @db.Decimal(18, 2)

  // ★ آی‌دی حساب مربوطه (از جدول Account)
  accountId String? @db.VarChar(450)

  // ★ برای موجودی کالا: آی‌دی محصول
  productId String?  @db.VarChar(450)
  quantity  Decimal? @db.Decimal(18, 4) // تعداد/مقدار

  // ★ توضیحات
  description String? @db.VarChar(500)

  // ★ آی‌دی سند افتتاحیه (JournalEntry)
  journalEntryId String? @db.VarChar(450)

  // ★ آیا این رکورد در سند افتتاحیه ثبت شده؟
  isPosted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Tenant       Tenant        @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  Account      Account?      @relation("InitialBalanceAccount", fields: [accountId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  Product      Product?      @relation("InitialBalanceProduct", fields: [productId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  JournalEntry JournalEntry? @relation("InitialBalanceJournalEntry", fields: [journalEntryId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([accountId])
  @@index([productId])
  @@index([journalEntryId])
  @@map("InitialBalances")
}

// ═══════════════════════════════════════════════════════════════
// ★★★ Admin Users (Super Admin Panel)
// ═══════════════════════════════════════════════════════════════
model AdminUser {
  id        String    @id @default(uuid()) @db.VarChar(450)
  username  String    @unique @db.VarChar(100)
  password  String    @db.VarChar(500) // هش‌شده با bcrypt
  role      String    @default("SuperAdmin") @db.VarChar(50)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("AdminUsers")
}

// ═══════════════════════════════════════════════════════════════
// ★★★ v8.8: دارایی‌های ثابت + استهلاک
// ----------------------------------------------------------------------------
// این مدل دارایی‌های ثابت فروشگاه (تجهیزات، ماشین‌آلات، مبلمان و...)
// را ذخیره می‌کند و استهلاک ماهانه خودکار را محاسبه می‌کند.
// ═══════════════════════════════════════════════════════════════

model FixedAsset {
  id       String @id @default(uuid()) @db.VarChar(450)
  tenantId String @db.VarChar(1000)

  // ★ اطلاعات دارایی
  name     String @db.VarChar(200)
  code     String @db.VarChar(50) // کد دارایی
  category String @db.VarChar(100) // تجهیزات، ماشین‌آلات، مبلمان، ساختمان

  // ★ مبالغ
  // ★★★ v10.0: تغییر همه مبالغ به Decimal
  purchasePrice    Decimal @default(0) @db.Decimal(18, 2) // بهای خرید
  salvageValue     Decimal @default(0) @db.Decimal(18, 2) // ارزش اسقاط (پس از عمر مفید)
  usefulLife       Int     @default(60) // عمر مفید (ماه)
  depreciationRate Decimal @default(0) @db.Decimal(10, 6) // نرخ استهلاک ماهانه (محاسبه خودکار)

  // ★ accumulated depreciation
  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 2) // استهلاک انباشته
  bookValue               Decimal @default(0) @db.Decimal(18, 2) // ارزش دفتری (purchasePrice - accumulatedDepreciation)

  // ★ dates
  purchaseDate          DateTime  @default(now())
  depreciationStartDate DateTime  @default(now()) // شروع استهلاک
  lastDepreciationDate  DateTime? // آخرین استهلاک

  // ★ method
  depreciationMethod String @default("straight_line") // straight_line | declining_balance

  // ★ status
  status String @default("active") // active | sold | disposed | fully_depreciated

  // ★ relations
  accountId           String? @db.VarChar(450) // حساب دارایی (1400)
  accumDepAccountId   String? @db.VarChar(450) // حساب استهلاک انباشته
  depExpenseAccountId String? @db.VarChar(450) // حساب هزینه استهلاک

  journalEntryId String? @db.VarChar(450) // سند خرید دارایی
  description    String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Tenant            Tenant        @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  Account           Account?      @relation("FixedAssetAccount", fields: [accountId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  AccumDepAccount   Account?      @relation("FixedAssetAccumDepAccount", fields: [accumDepAccountId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  DepExpenseAccount Account?      @relation("FixedAssetDepExpenseAccount", fields: [depExpenseAccountId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  JournalEntry      JournalEntry? @relation("FixedAssetJournalEntry", fields: [journalEntryId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([accountId])
  @@index([journalEntryId])
  @@map("FixedAssets")
}
