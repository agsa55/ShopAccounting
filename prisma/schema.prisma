// prisma/schema.prisma — Unified Database Schema (v9.0)
// ShopAccounting — Single Shared Database Architecture
// ============================================================================
// ★ v3.31: فیلدهای ابطال سند
// ★ v6.0: MoidianSettings + فیلدهای مودیان
// ★ v6.1: انبارداری + فاکتور خرید + تامین‌کنندگان
// ★ v9.0:  تغییر ساختار پلن‌ها
//          - حذف پلن ماهانه
//          - دوره‌ها: annual (۳۶۵ روز) + lifetime (مادام‌العمر، durationDays = 0)
//          - تغییر نام پلن‌ها: ساده→پایه، حرفه‌ای→پیشرفته، سازمانی→حرفه‌ای
//          - default billingCycle در Tenant از 'monthly' به 'annual' تغییر کرد
// ============================================================================

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native"]
}

model Tenant {
  id                 String   @id @db.NVarChar(1000)
  subDomain          String   @unique
  companyName        String
  planName           String   @default("simple")
  status             String   @default("active")
  ownerName          String?
  ownerMobile        String?
  ownerEmail         String?
  address            String?
  registrationNumber String?
  logoUrl            String?

  planTierId         Int?
  // ★★★ v9.0: دوره اشتراک — فقط 'annual' (سالانه، ۳۶۵ روز) یا 'lifetime' (مادام‌العمر)
  //   - مقدار 'monthly' قدیمی است و در seed-plans.ts به 'annual' مهاجرت می‌شود.
  //   - 'lifetime' یعنی بدون تاریخ انقضا (expiresAt = null).
  billingCycle       String   @default("annual")
  // ★★★ v9.0: اگر billingCycle = 'lifetime' باشد، expiresAt باید null باشد.
  expiresAt          DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  soldAt             DateTime?
  soldTo             String?
  soldToContact      String?

  planTier             PlanTier?              @relation(fields: [planTierId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  AuditLogs            AuditLogs[]
  OtpCodes             OtpCode[]
  PortalUsers          PortalUsers[]
  SubscriptionPayments SubscriptionPayments[]
  Subscriptions        Subscriptions[]
  UserLookups          UserLookups[]

  StoreUsers        StoreUser[]
  Products          Product[]
  Categories        Category[]
  Units             Unit[]
  Customers         Customer[]
  Accounts          Account[]
  Invoices          Invoice[]
  InvoicePayments   InvoicePayment[]
  InstallmentPlans  InstallmentPlan[]
  InstallmentSchedules InstallmentSchedule[]
  JournalEntries    JournalEntry[]
  StoreSettings     StoreSetting[]
  PaymentGateways   PaymentGateway[]
  PosDevices        PosDevice[]
  Backups           Backup[]
  Checks            Check[]
  FiscalYears       FiscalYear[]
  OnlinePayments    OnlinePayment[]
  SmsSettings       SmsSettings?
  SmsLogs           SmsLog[]
  RecurringJournals RecurringJournal[]

  // ★★★ v6.0: مودیان
  MoidianSettings   MoidianSettings?

  // ★★★ v6.1: انبارداری + خرید
  Warehouses         Warehouse[]
  StockLevels        StockLevel[]
  StockMovements     StockMovement[]
  Suppliers          Supplier[]
  PurchaseInvoices   PurchaseInvoice[]

  // ★★★ v6.5: انبار گردانی
  StockCounts        StockCount[]

  // ★★★ v7.1: شعب
  Branches           Branch[]

  // ★★★ v8.0: پرداخت‌های کارتی
  CardPayments       CardPayment[]

  // ★★★ v8.6: تیکت پشتیبانی
  Tickets            Ticket[]

  // ★★★ v8.8: راه‌اندازی اولیه فروشگاه
  InitialBalances    InitialBalance[]
  FixedAssets        FixedAsset[]

  @@index([createdAt])
  @@index([planName])
  @@index([status])
  @@index([planTierId])
  @@map("Tenants")
}

model OtpCode {
  id           String    @id @db.NVarChar(450)
  tenantId     String   @db.NVarChar(1000)
  mobile       String
  code         String
  codeHash     String    @default("")
  purpose      String    @default("login")
  isUsed       Boolean   @default(false)
  attemptCount Int       @default(0)
  ip           String?
  expiresAt    DateTime
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  Tenant       Tenant    @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([expiresAt])
  @@index([mobile, purpose, isUsed, expiresAt])
  @@index([tenantId])
  @@map("OtpCodes")
}

model AuditLogs {
  id         String   @id @db.NVarChar(450)
  tenantId   String   @db.NVarChar(1000)
  userId     String?
  action     String
  entityType String?
  entityId   String?
  details    String?
  at         DateTime @default(now())
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([at])
  @@index([entityType, entityId])
  @@index([tenantId, action])
  @@index([userId])
  @@map("AuditLogs")
}

model Plans {
  id                 String          @id @db.NVarChar(450)
  name               String          @unique
  nameFa             String
  price              Float
  // ★★★ v9.0: durationDays = 0 یعنی «مادام‌العمر / بدون انقضا»
  durationDays       Int
  maxUsers           Int             @default(2)
  maxProducts        Int             @default(100)
  features           String?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  isTrial            Boolean         @default(false)
  trialDays          Int             @default(0)
  requiresIsolatedDb Boolean         @default(false)
  dbType             String          @default("shared")
  autoDeleteOnExpiry Boolean         @default(false)
  tier               String          @default("basic")
  maxInvoices        Int             @default(100)
  Subscriptions      Subscriptions[]

  @@index([dbType])
  @@index([isActive])
  @@index([isTrial])
  @@index([tier])
  @@map("Plans")
}

model PortalUsers {
  id          String    @id @db.NVarChar(450)
  tenantId    String   @db.NVarChar(1000)
  username    String
  password    String
  mobile      String?
  role        String    @default("Manager")
  permissions String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  Tenant      Tenant    @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([tenantId, username])
  @@index([mobile])
  @@index([tenantId])
  @@map("PortalUsers")
}

model SubscriptionPayments {
  id             String        @id @db.NVarChar(450)
  subscriptionId String   @db.NVarChar(450)
  tenantId       String   @db.NVarChar(1000)
  amount         Float
  paymentMethod  String?
  paymentRef     String?
  isPaid         Boolean       @default(false)
  status         String        @default("pending")
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  Subscriptions  Subscriptions @relation(fields: [subscriptionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Tenant         Tenant        @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([paidAt])
  @@index([tenantId, isPaid])
  @@map("SubscriptionPayments")
}

model Subscriptions {
  id                   String                 @id @db.NVarChar(450)
  tenantId             String   @db.NVarChar(1000)
  planId               String   @db.NVarChar(450)
  startDate            DateTime
  endDate              DateTime
  status               String                 @default("active")
  autoRenew            Boolean                @default(false)
  createdAt            DateTime               @default(now())
  SubscriptionPayments SubscriptionPayments[]
  Plans                Plans                  @relation(fields: [planId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Tenant               Tenant                 @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([endDate])
  @@index([status, endDate])
  @@index([status])
  @@index([tenantId, status])
  @@map("Subscriptions")
}

model UserLookups {
  id        String   @id @db.NVarChar(450)
  username  String   @unique
  tenantId  String  @db.NVarChar(1000)
  userType  String   @default("storeUser")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  Tenant    Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([isActive])
  @@index([tenantId])
  @@index([username])
  @@map("UserLookups")
}

model PlanTier {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  nameFa        String
  description   String?
  maxUsers      Int      @default(2)
  maxProducts   Int      @default(200)
  maxInvoices   Int      @default(500)
  isTrial       Boolean  @default(false)
  trialDays     Int      @default(0)
  dbType        String   @default("shared")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prices        PlanPrice[]
  tenants       Tenant[]

  @@map("PlanTiers")
}

model PlanPrice {
  id              Int      @id @default(autoincrement())
  planTierId      Int
  // ★★★ v9.0: مقادیر مجاز:
  //   - 'annual'    : سالانه (۳۶۵ روز)
  //   - 'lifetime'  : مادام‌العمر (durationDays = 0، یعنی بدون انقضا)
  //   - 'monthly'   : قدیمی — در seed-plans.ts غیرفعال می‌شود
  billingCycle    String
  // ★★★ v9.0: durationDays = 0 یعنی «نامحدود / مادام‌العمر»
  durationDays    Int
  price           Int
  discountPercent Int      @default(0)
  isActive        Boolean  @default(true)
  isPopular       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  planTier        PlanTier @relation(fields: [planTierId], references: [id], onDelete: Cascade)

  @@unique([planTierId, billingCycle])
  @@map("PlanPrices")
}

model StoreUser {
  id              String    @id @default(uuid()) @db.NVarChar(450)
  username        String
  password        String
  mobile          String?
  role            String    @default("Cashier")
  permissions     String?
  tenantId        String  @db.NVarChar(1000)
  storeId         String?   @db.NVarChar(1000)
  storeName       String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  failedAttempts  Int       @default(0)
  lockoutEnd      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  Tenant    Tenant     @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  invoices  Invoice[]
  // ★★★ v8.6: تیکت‌هایی که این کاربر ایجاد کرده
  Tickets   Ticket[]
  TicketMessages TicketMessage[]

  @@unique([username, tenantId])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([mobile])
  @@map("StoreUsers")
}

model Product {
  id            String   @id @default(uuid()) @db.NVarChar(450)
  code          String
  barcode       String?  @db.NVarChar(50)
  name          String   @db.NVarChar(500)
  categoryId    String?  @db.NVarChar(450)
  unitId        String?  @db.NVarChar(450)
  
  // ★★★ v8.8.7: واحد محصول پیش‌فرض (عدد، کیلوگرم، متر، لیتر، ...)
  unitLabel     String   @default("عدد") @db.NVarChar(50)
  
  purchasePrice Float    @default(0)
  salePrice     Float    @default(0)
  taxRate       Float    @default(0)
  currentStock  Float    @default(0)          // ★ تغییر: از Int به Float
  minStock      Float    @default(0)
  isActive      Boolean  @default(true)
  tenantId      String   @db.NVarChar(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  Tenant   Tenant    @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  category Category? @relation(fields: [categoryId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])

  StockLevels          StockLevel[]
  StockMovements       StockMovement[]
  PurchaseInvoiceItems PurchaseInvoiceItem[]
  StockCountItems      StockCountItem[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@index([barcode])
  @@index([categoryId])
  InitialBalances InitialBalance[] @relation("InitialBalanceProduct")
  @@map("Products")
}

model Category {
  id        String   @id @default(uuid()) @db.NVarChar(450)
  name      String
  parentId  String?  @db.NVarChar(450)
  isActive  Boolean  @default(true)
  tenantId  String   @db.NVarChar(1000)
  createdAt DateTime @default(now())

  Tenant   Tenant    @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  products Product[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([parentId])
  @@map("ProductCategories")
}

model Unit {
  id        String   @id @default(uuid()) @db.NVarChar(450)
  name      String
  nameFa    String
  symbol    String?
  isDefault Boolean  @default(false)
  tenantId  String   @db.NVarChar(1000)
  createdAt DateTime @default(now())

  Tenant   Tenant    @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  products Product[]

  @@index([tenantId])
  @@map("Units")
}

model Customer {
  id              String    @id @default(uuid()) @db.NVarChar(450)
  code            String
  firstName       String
  lastName        String
  mobile          String?
  nationalCode    String?
  address         String?
  creditLimit     Float     @default(0)
  currentBalance  Float     @default(0)
  isBlacklisted   Boolean   @default(false)
  tenantId        String    @db.NVarChar(1000)
  createdAt       DateTime  @default(now())
  lastPurchaseAt  DateTime?
  portalToken     String?   @unique
  // ★★★ v7.4: طرف حساب — شخص حقوقی
  personType      String    @default("person") @db.NVarChar(10) // person | legal
  economicCode    String?   @db.NVarChar(20)
  companyName     String?   @db.NVarChar(200)
  legalForm       String?   @db.NVarChar(100)

  Tenant   Tenant     @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  invoices Invoice[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@index([tenantId, mobile])
  @@index([tenantId, lastName])
  @@map("Customers")
}

model Account {
  id        String   @id @default(uuid()) @db.NVarChar(450)
  code      String
  name      String
  type      String   @default("cash")
  level     Int      @default(1)
  parentId  String?  @db.NVarChar(450)
  isActive  Boolean  @default(true)
  tenantId  String   @db.NVarChar(1000)
  createdAt DateTime @default(now())

  Tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  InitialBalances InitialBalance[] @relation("InitialBalanceAccount")
  FixedAssets FixedAsset[] @relation("FixedAssetAccount")
  FixedAssetsAccumDep FixedAsset[] @relation("FixedAssetAccumDepAccount")
  FixedAssetsDepExpense FixedAsset[] @relation("FixedAssetDepExpenseAccount")

  @@unique([code, tenantId])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([parentId])
  @@map("Accounts")
}

// ★★★ v8.8: relation برای موجودی اولیه
// (اضافه شده به انتهای مدل Account بالا)

model Invoice {
  id              String    @id @default(uuid()) @db.NVarChar(450)
  number          String
  customerId      String?   @db.NVarChar(450)
  invoiceDate     DateTime  @default(now())
  dueDate         DateTime?
  status          String    @default("draft")
  paymentType     String    @default("cash")
  subTotal        Float     @default(0)
  discountAmount  Float     @default(0)
  taxAmount       Float     @default(0)
  totalAmount     Float     @default(0)
  paidAmount      Float     @default(0)
  remainingAmount Float     @default(0)
  // ★★★ v8.1.1: بهای تمام‌شده کالای فروش‌رفته (COGS)
  //   برای محاسبه سود ناخالص در گزارش‌ها
  cogsAmount      Float     @default(0)
  cashierId       String?   @db.NVarChar(450)
  description     String?
  tenantId        String    @db.NVarChar(1000)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ★★★ v8.7: نوع فاکتور — sale | sale_return | service
  //   sale (پیش‌فرض): فاکتور فروش عادی
  //   sale_return: فاکتور برگشتی فروش (مرجوع از مشتری)
  //   service: فاکتور تعمیرات و خدمات (بدون محصول، فقط آیتم‌های خدماتی)
  invoiceType     String    @default("sale") @db.NVarChar(30)

  // ★★★ v8.7: در صورت برگشتی، آی‌دی فاکتور اصلی که از آن برگشته
  originalInvoiceId String? @db.NVarChar(450)

  // ★★★ v8.7: در صورت فاکتور خدماتی، نام/کد دستگاه یا وسیله تعمیر شده (اختیاری)
  serviceDevice   String?   @db.NVarChar(500)
  serviceWarranty Boolean   @default(false)

  // ★★★ v6.0: فیلدهای مودیان
  moidianReferenceId   String?   @db.NVarChar(100)
  moidianStatus        String?   @db.NVarChar(50)
  moidianSubmittedAt   DateTime?
  moidianAcceptedAt    DateTime?
  moidianError         String?   @db.NVarChar(500)
  moidianRetryCount    Int       @default(0)

  // ★★★ v6.1: انبار
  warehouseId        String?   @db.NVarChar(450)

  Tenant   Tenant           @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  customer Customer?        @relation(fields: [customerId], references: [id])
  cashier  StoreUser?       @relation(fields: [cashierId], references: [id])
  items    InvoiceItem[]
  payments InvoicePayment[]
  installmentPlan InstallmentPlan?
  onlinePayments OnlinePayment[]
  // ★★★ v6.1: relation به انبار
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])
  // ★★★ v8.0: relation به پرداخت‌های کارتی
  cardPayments   CardPayment[] @relation("CardPaymentInvoice")

  @@unique([number, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, paymentType])
  @@index([tenantId, invoiceType])
  @@index([customerId])
  @@index([cashierId])
  @@index([tenantId, moidianStatus])
  @@index([moidianReferenceId])
  @@index([originalInvoiceId])
  @@map("Invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.NVarChar(450)
  invoiceId      String   @db.NVarChar(450)
  productId      String?  @db.NVarChar(450)
  productName    String   @db.NVarChar(500)
  
  // ★★★ v8.8.7: واحد محصول / خدمت
  unitLabel      String   @default("عدد") @db.NVarChar(50)
  
  quantity       Float    @default(1)          // ★ تغییر: از Int به Float
  unitPrice      Float    @default(0)
  discountAmount Float    @default(0)
  taxAmount      Float    @default(0)
  lineTotal      Float    @default(0)

  // ★★★ v8.7: فیلدهای اضافی برای آیتم‌های خدماتی
  // برای فاکتورهای service: توضیحات کامل خدمت (مثلاً «تعمیر موتور یخچال»)
  // برای فاکتورهای sale_return: دلیل برگشت (اختیاری)
  description    String?  @db.NVarChar(500)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([productId])
  @@map("InvoiceItems")
}
model InvoicePayment {
  id          String   @id @default(uuid()) @db.NVarChar(450)
  invoiceId   String   @db.NVarChar(450)
  amount      Float
  paymentType String   @default("cash")
  paymentRef  String?
  paidAt      DateTime @default(now())
  tenantId    String   @db.NVarChar(1000)

  Tenant  Tenant  @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([tenantId, paidAt])
  @@map("InvoicePayments")
}

model InstallmentPlan {
  id                    String    @id @default(uuid()) @db.NVarChar(450)
  invoiceId             String    @unique @db.NVarChar(450)
  customerId            String?
  totalAmount           Float     @default(0)
  downPayment           Float     @default(0)
  remainingAmount       Float     @default(0)
  interestRate          Float     @default(0)
  totalWithInterest     Float     @default(0)
  numberOfInstallments  Int       @default(1)
  installmentAmount     Float     @default(0)
  installmentPeriod     String    @default("monthly")
  status                String    @default("active")
  paidInstallments      Int       @default(0)
  totalPaidAmount       Float     @default(0)
  nextDueDate           DateTime?
  description           String?
  tenantId              String  @db.NVarChar(1000)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  Tenant    Tenant                @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  invoice   Invoice               @relation(fields: [invoiceId], references: [id])
  schedules InstallmentSchedule[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, nextDueDate])
  @@map("InstallmentPlans")
}

model InstallmentSchedule {
  id                 String    @id @default(uuid()) @db.NVarChar(450)
  planId             String   @db.NVarChar(450)
  installmentNumber  Int
  amount             Float     @default(0)
  dueDate            DateTime
  status             String    @default("pending")
  paidAmount         Float     @default(0)
  paidAt             DateTime?
  paymentRef         String?
  paymentType        String?
  notes              String?
  tenantId           String  @db.NVarChar(1000)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  Tenant Tenant          @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  plan   InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, installmentNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("InstallmentSchedules")
}

model JournalEntry {
  id           String    @id @default(uuid()) @db.NVarChar(450)
  number       String    @default("JE-000000")
  fiscalYearId String?   @db.NVarChar(450)
  date         DateTime  @default(now())
  description  String?
  status       String    @default("draft")
  sourceType   String?
  sourceId     String?   @db.NVarChar(450)
  totalDebit   Float     @default(0)
  totalCredit  Float     @default(0)
  createdBy    String?   @db.NVarChar(450)
  tenantId     String    @db.NVarChar(1000)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

