  // ★★★ v8.0: Universal POS Adapter fields ★★★
  // نوع ترمینال: manual | keyboard-hid | web-serial | network-tcp | network-http
  terminalType    String   @default("manual") @db.NVarChar(50)

  // نوع کارتخوان (برند): verifone | ingenico | pax | fannipars | kavosh | palch | generic
  brand           String?  @db.NVarChar(50)

  // اطلاعات بانکی
  bankName        String?  @db.NVarChar(100)
  merchantId      String?  @db.NVarChar(50)
  acceptorCode    String?  @db.NVarChar(50)
  terminalSerial  String?  @db.NVarChar(100)

  // تنظیمات اتصال بر اساس terminalType
  // web-serial: serialPort, baudRate
  // network-tcp: ipAddress, port
  // network-http: apiBaseUrl, apiKey
  ipAddress       String?  @db.NVarChar(50)
  port            Int?
  serialPort      String?  @db.NVarChar(100)
  baudRate        Int      @default(115200)
  apiBaseUrl      String?  @db.NVarChar(500)
  apiKey          String?  @db.NVarChar(500)

  // تنظیمات پیشرفته (JSON string)
  // - autoReconnect, timeoutMs, retryCount
  // - shaparakVerify (boolean), shaparakMerchantCode
  // - receiptPrinterWidth, receiptFooter
  config          String?  @db.NVarChar(max)

