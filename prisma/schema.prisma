model PurchaseInvoice {
  id              String    @id @default(uuid()) @db.NVarChar(450)
  tenantId        String    @db.NVarChar(1000)
  supplierId      String?   @db.NVarChar(450)
  number          String
  invoiceDate     DateTime  @default(now())
  dueDate         DateTime?
  status          String    @default("draft")
  paymentType     String    @default("cash")
  subTotal        Float     @default(0)
  discountAmount  Float     @default(0)
  taxAmount       Float     @default(0)
  totalAmount     Float     @default(0)
  paidAmount      Float     @default(0)
  remainingAmount Float     @default(0)
  warehouseId     String    @db.NVarChar(450)
  journalEntryId  String?   @db.NVarChar(450)
  description     String?   @db.NVarChar(500)
  cashierId       String?   @db.NVarChar(450)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ★★★ v8.7: نوع فاکتور خرید — purchase | purchase_return
  //   purchase (پیش‌فرض): فاکتور خرید عادی
  //   purchase_return: فاکتور برگشتی خرید (مرجوع به تامین‌کننده)
  invoiceType     String    @default("purchase") @db.NVarChar(30)
  //   در صورت برگشتی، آی‌دی فاکتور اصلی که از آن برگشته
  originalPurchaseInvoiceId String? @db.NVarChar(450)

  Tenant        Tenant              @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: Cascade)
