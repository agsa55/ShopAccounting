  Invoices       Invoice[]

  // ★★★ v6.5: انبار گردانی
  StockCounts    StockCount[]

  // ★★★ v7.1: relation به شعبه (CASCADE → NO ACTION برای جلوگیری از circular cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([code, tenantId])
