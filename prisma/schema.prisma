  @@index([terminalType])
  @@map("PosDevices")
}

// ★★★ v8.0: ثبت پرداخت‌های کارتی ★★★
// هر بار که مشتری با کارتخوان پرداخت می‌کنه، یک رکورد اینجا ذخیره می‌شه
// شامل شماره پیرو، ۴ رقم آخر کارت، مبلغ، وضعیت تأیید
model CardPayment {
  id              String   @id @default(uuid()) @db.NVarChar(450)
  invoiceId       String?  @db.NVarChar(450)

  // اطلاعات تراکنش
  amount          Float
  referenceNumber String?  @db.NVarChar(50)   // شماره پیرو (RRN) یا هر کد مرجع دیگه
  referenceType   String?  @db.NVarChar(20)   // ★★★ v8.1: نوع کد مرجع (rrn | unique_code | trace | terminal | auth_code | stan | other)
  traceNumber     String?  @db.NVarChar(50)   // شماره پیگیری
  cardNumber      String?  @db.NVarChar(4)    // ۴ رقم آخر کارت
  cardType        String?  @db.NVarChar(20)   // bankaii | melli | saderat | ... | unknown

  // وضعیت
  status          String   @default("pending") @db.NVarChar(20)  // pending | successful | failed | reversed

  // ارتباط با کارتخوان
  posDeviceId     String?  @db.NVarChar(450)

  // تأیید شاپرک
  shaparakVerified Boolean @default(false)
  shaparakVerifyError String? @db.NVarChar(500)

  // متادیتا
  paidAt          DateTime @default(now())
  description     String?
  tenantId        String   @db.NVarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ★★★ v8.0: relations
  posDevice PosDevice? @relation(fields: [posDeviceId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  invoice   Invoice?   @relation("CardPaymentInvoice", fields: [invoiceId], references: [id], onUpdate: NoAction, onDelete: SetNull)

  Tenant Tenant @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, paidAt])
  @@index([posDeviceId])
  @@index([invoiceId])
  @@index([referenceNumber])
  @@map("CardPayments")
}

