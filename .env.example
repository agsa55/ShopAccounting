# ═══════════════════════════════════════════════════════════════
# ★ رهگشا - فایل نمونه متغیرهای محیطی (Template)
# ★ این فایل را کپی کرده و با نام .env یا .env.production ذخیره کنید
# ★ ⚠️ هرگز این فایل را با مقادیر واقعی در Git commit نکنید!
# ═══════════════════════════════════════════════════════════════

# ─── دیتابیس ────────────────────────────────────────────────
# ★ PostgreSQL - اطلاعات دیتابیس خود را وارد کنید
# ★ نحوه ایجاد: createdb ShopAccounting_PG
DATABASE_URL="postgresql://username:password@localhost:5432/ShopAccounting_PG?schema=public"

# ─── رمزگذاری عمومی ─────────────────────────────────────────
# ★ برای رمزنگاری داده‌های حساس (64 کاراکتر hex)
# ★ تولید: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here"

# ─── JWT (احراز هویت) ───────────────────────────────────────
# ★ ⚠️ حتماً مقادیر تصادفی و قوی وارد کنید (حداقل 64 کاراکتر)
# ★ تولید: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="your-access-secret-min-64-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-64-chars"

# ─── Redis (اختیاری) ─────────────────────────────────────────
# ★ برای کشینگ و صف‌های کاری
# ★ اگر Redis ندارید، REDIS_DISABLED=true را پایین‌تر تنظیم کنید
REDIS_URL="redis://localhost:6379"

# ─── Cron Job ────────────────────────────────────────────────
# ★ رمز محافظت از endpoint های cron
CRON_SECRET="your-cron-secret-here"

# ─── Rate Limiting ───────────────────────────────────────────
# ★ محدودیت تعداد درخواست در هر بازه زمانی
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="60000"

# ─── URL پایه اپلیکیشن ──────────────────────────────────────
# ★ برای ساخت callback URL و لینک‌های ایمیل/پیامک
# ★ در production: https://rahgooshasf.ir
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── گوگل سرچ کنسول (SEO) ──────────────────────────────────
# ★ کد تایید از Google Search Console
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# ─── محیط اجرا ───────────────────────────────────────────────
# ★ development یا production
NODE_ENV=development
PORT=3000

# ─── غیرفعال کردن Redis (برای منابع محدود) ──────────────────
# ★ اگر Redis ندارید، این را true کنید
REDIS_DISABLED=true

# ─── غیرفعال کردن مودیان (اختیاری) ──────────────────────────
# ★ اگر فعلاً با سامانه مودیان کار نمی‌کنید، true کنید
MOIDIAN_DISABLED=false

# ═══════════════════════════════════════════════════════════════
# درگاه پرداخت آنلاین — زرین‌پال
# ═══════════════════════════════════════════════════════════════
# ★ این درگاه فقط برای پرداخت حق اشتراک پلتفرم استفاده می‌شود
# ★ هر فروشگاه درگاه اختصاصی خودش را در پنل تنظیم می‌کند

# ★ Merchant ID از پنل زرین‌پال
# ★ تست: 00000000-0000-0000-0000-000000000000
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# ★ true = محیط تست (Sandbox) | false = محیط واقعی (Production)
ZARINPAL_SANDBOX=true

# ═══════════════════════════════════════════════════════════════
# سرویس پیامک IPPanel (OTP)
# ═══════════════════════════════════════════════════════════════

# ★ API Key از پنل IPPanel
IPPANEL_API_KEY="your-ippanel-api-key-here"

# ★ خط خدماتی اشتراکی
IPPANEL_FROM_NUMBER="3000505"

# ★ کد پترن OTP از پنل IPPanel
IPPANEL_OTP_PATTERN_CODE="your-otp-pattern-code"
IPPANEL_NOTIFICATION_PATTERN_CODE="your-notification-pattern-code"

# ★ نام متغیر در پترن (طبق تنظیمات پنل IPPanel)
IPPANEL_OTP_PARAM_NAME="pass"
IPPANEL_NOTIFICATION_PARAM_NAME="price"

# ═══════════════════════════════════════════════════════════════
# سامانه مودیان (Tax Integration)
# ═══════════════════════════════════════════════════════════════

# ★ ⚠️ کلید رمزنگاری AES-256 برای credentials مودیان
# ★ طول: ۶۴ کاراکتر hex (۳۲ بایت)
# ★ تولید: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ★ ⚠️ اگر این کلید را تغییر دهید، credentials قبلی غیرقابل رمزگشایی می‌شوند!
MOIDIAN_ENCRYPTION_KEY="your-64-char-hex-moidian-encryption-key-here"

# ─── تنظیمات اختیاری مودیان (URL های پیش‌فرض) ─────────────
# MOIDIAN_SANDBOX_URL="https://sandbox-api.tax.gov.ir"
# MOIDIAN_PRODUCTION_URL="https://api.tax.gov.ir"